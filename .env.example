# MongoDB Atlas Connection String
# Contoh: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/monev_bot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/monev_bot?retryWrites=true&w=majority

# Port Express Server (default Render/Koyeb: PORT disediakan otomatis oleh env sistem)
PORT=3000

# (Opsional) Nomor WhatsApp SuperAdmin (dipisahkan koma, tanpa simbol +)
# Nomor ini otomatis diizinkan menjalankan perintah admin (!hapus, !test-reminder, !anggota)
ADMIN_NUMBERS=628123456789,628987654321

# (Opsional) URL Portal Absensi yang disertakan dalam pesan reminder
ATTENDANCE_PORTAL_URL=https://portal-absensi-anda.com

